@model Administration.Models.ViewModels.TrainingViewModel

@{
    ViewData["Title"] = "Modifier l'Entrainement";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">
                    <i class="fas fa-edit text-primary"></i>
                    Modifier l'Entrainement: @Model.Title
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" 
                                  placeholder="Décrivez l'entrainement en détail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <small class="form-text text-muted">Maximum 1000 caractères</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DurationMinutes" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DurationMinutes" type="number" class="form-control" min="1" />
                                    <span class="input-group-text">minutes</span>
                                </div>
                                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Level" class="form-label"></label>
                                <select asp-for="Level" class="form-select">
                                    <option value="">-- Choisir un niveau --</option>
                                    <option value="Facile">Facile</option>
                                    <option value="Moyen">Moyen</option>
                                    <option value="Difficile">Difficile</option>
                                </select>
                                <span asp-validation-for="Level" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Equipment" class="form-label"></label>
                        <input asp-for="Equipment" class="form-control" />
                        <span asp-validation-for="Equipment" class="text-danger"></span>
                    </div>

                    <!-- Section Programmes Associés -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fas fa-clipboard-list text-success"></i>
                            Modifier l'association aux programmes
                        </label>
                        <div class="card">
                            <div class="card-body">
                                @if (ViewBag.AvailablePrograms != null && ((List<SelectListItem>)ViewBag.AvailablePrograms).Any())
                                {
                                    <div class="row">
                                        @foreach (var program in (List<SelectListItem>)ViewBag.AvailablePrograms)
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" 
                                                           name="SelectedProgramIds" 
                                                           value="@program.Value" 
                                                           id="program_@program.Value"
                                                           @(program.Selected ? "checked" : "") />
                                                    <label class="form-check-label" for="program_@program.Value">
                                                        <strong>@program.Text</strong>
                                                        @if (program.Selected)
                                                        {
                                                            <span class="badge bg-success ms-2">Actuellement inclus</span>
                                                        }
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="form-text mt-2">
                                        <i class="fas fa-info-circle"></i>
                                        Cochez ou décochez les programmes pour modifier les associations.
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                                        <p>Aucun programme disponible.</p>
                                        <a asp-controller="Programs" asp-action="Create" class="btn btn-sm btn-success" target="_blank">
                                            <i class="fas fa-plus"></i>
                                            Créer un programme
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary me-md-2">
                            <i class="fas fa-times"></i>
                            Annuler
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-md-2">
                            <i class="fas fa-eye"></i>
                            Détails
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            Sauvegarder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script pour améliorer l'UX de sélection des programmes
        document.addEventListener('DOMContentLoaded', function() {
            const checkboxes = document.querySelectorAll('input[name="SelectedProgramIds"]');
            const updateCounter = () => {
                const selected = document.querySelectorAll('input[name="SelectedProgramIds"]:checked').length;
                const label = document.querySelector('label[for="SelectedProgramIds"]');
                if (label) {
                    const badge = label.querySelector('.badge') || document.createElement('span');
                    badge.className = 'badge bg-primary ms-2';
                    badge.textContent = `${selected} programme(s) sélectionné(s)`;
                    if (!label.querySelector('.badge')) {
                        label.appendChild(badge);
                    }
                }
            };
            
            checkboxes.forEach(cb => {
                cb.addEventListener('change', function() {
                    updateCounter();
                    // Visual feedback for changes
                    const label = this.nextElementSibling;
                    const badge = label.querySelector('.badge.bg-success');
                    if (badge) {
                        if (this.checked) {
                            badge.textContent = 'Inclus';
                            badge.className = 'badge bg-success ms-2';
                        } else {
                            badge.textContent = 'Retiré';
                            badge.className = 'badge bg-warning ms-2';
                        }
                    }
                });
            });
            updateCounter(); // Initial count
        });
    </script>
}