@model Administration.Models.Entities.Training

@{
    ViewData["Title"] = "Détails de l'Entrainement";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-info-circle"></i>
                        Détails de l'Entrainement
                    </h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="fas fa-heading"></i> Titre
                        </dt>
                        <dd class="col-sm-8">
                            <strong>@Model.Title</strong>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-align-left"></i> Description
                        </dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p>@Model.Description</p>
                            }
                            else
                            {
                                <em class="text-muted">Aucune description</em>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-clock"></i> Durée
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.DurationMinutes minutes</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-signal"></i> Niveau
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-warning text-dark">@Model.Level</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-tools"></i> Équipement requis
                        </dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Equipment))
                            {
                                @Model.Equipment
                            }
                            else
                            {
                                <em class="text-muted">Aucun équipement requis</em>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Supprimer
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>