@model Administration.Models.Entities.ProgramEntity

@{
    ViewData["Title"] = "Détails du programme";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-5">
                <i class="fas fa-clipboard-list text-success"></i>
                Détails du Programme
            </h1>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Modifier
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-list"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">@Model.Title</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-4 text-center">
                        <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 300px;">
                    </div>
                }

                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Difficulty)</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.Difficulty))
                                {
                                    <span class="badge bg-info fs-6">@Model.Difficulty</span>
                                }
                                else
                                {
                                    <span class="text-muted">Non défini</span>
                                }
                            </dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
                            <dd class="col-sm-8">
                                <strong class="text-success fs-5">@Model.Price.ToString("C")</strong>
                            </dd>
                        </dl>
                    </div>
                    
                    <div class="col-md-6">
                        @if (!string.IsNullOrEmpty(Model.Summary))
                        {
                            <h6>Résumé :</h6>
                            <p class="text-muted">@Model.Summary</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-dumbbell text-warning"></i>
                    Entrainements inclus
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Trainings?.Any() == true)
                {
                    <p class="text-success mb-3">
                        <i class="fas fa-check-circle"></i>
                        <strong>@Model.Trainings.Count() entrainement(s)</strong> dans ce programme
                    </p>
                    
                    @foreach (var training in Model.Trainings)
                    {
                        <div class="border rounded p-3 mb-3 bg-light">
                            <h6 class="text-primary mb-2">
                                <i class="fas fa-play-circle"></i>
                                @training.Title
                            </h6>
                            
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        <i class="fas fa-clock"></i>
                                        @if (training.DurationMinutes > 0)
                                        {
                                            @training.DurationMinutes @("min")
                                        }
                                        else
                                        {
                                            @("Durée non définie")
                                        }
                                    </small>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">
                                        <i class="fas fa-signal"></i>
                                        @if (!string.IsNullOrEmpty(training.Level))
                                        {
                                            @training.Level
                                        }
                                        else
                                        {
                                            @("Niveau non défini")
                                        }
                                    </small>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(training.Equipment))
                            {
                                <div class="mt-2">
                                    <small class="text-info">
                                        <i class="fas fa-tools"></i>
                                        <strong>Équipement :</strong> @training.Equipment
                                    </small>
                                </div>
                            }
                        </div>
                    }

                    <div class="mt-3">
                        <div class="alert alert-info">
                            <small>
                                <i class="fas fa-info-circle"></i>
                                <strong>Durée totale estimée :</strong> 
                                @Model.Trainings.Sum(t => t.DurationMinutes) minutes
                            </small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <p>Aucun entrainement associé à ce programme.</p>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-plus"></i>
                            Ajouter des entrainements
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Supprimer
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>