@model Administration.Models.ViewModels.ProgramViewModel

@{
    ViewData["Title"] = "Modifier le programme";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">
                    <i class="fas fa-edit text-primary"></i>
                    Modifier le Programme: @Model.Title
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label"></label>
                        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Difficulty" class="form-label"></label>
                                <select asp-for="Difficulty" class="form-select">
                                    <option value="">-- Choisir une difficulté --</option>
                                    <option value="Facile">Facile</option>
                                    <option value="Moyen">Moyen</option>
                                    <option value="Difficile">Difficile</option>
                                </select>
                                <span asp-validation-for="Difficulty" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Price" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">€</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label"></label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <div class="form-text">URL de l'image représentant le programme (optionnel)</div>
                    </div>

                    <!-- Section Entrainements Associés -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fas fa-dumbbell text-warning"></i>
                            Modifier les entrainements de ce programme
                        </label>
                        <div class="card">
                            <div class="card-body">
                                @if (ViewBag.AvailableTrainings != null && ((List<SelectListItem>)ViewBag.AvailableTrainings).Any())
                                {
                                    <div class="row">
                                        @foreach (var training in (List<SelectListItem>)ViewBag.AvailableTrainings)
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" 
                                                           name="SelectedTrainingIds" 
                                                           value="@training.Value" 
                                                           id="training_@training.Value"
                                                           @(training.Selected ? "checked" : "") />
                                                    <label class="form-check-label" for="training_@training.Value">
                                                        <strong>@training.Text</strong>
                                                        @if (training.Selected)
                                                        {
                                                            <span class="badge bg-success ms-2">Actuellement inclus</span>
                                                        }
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="form-text mt-2">
                                        <i class="fas fa-info-circle"></i>
                                        Cochez ou décochez les entrainements pour modifier ce programme.
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                                        <p>Aucun entrainement disponible.</p>
                                        <a asp-controller="Trainings" asp-action="Create" class="btn btn-sm btn-warning" target="_blank">
                                            <i class="fas fa-plus"></i>
                                            Créer un entrainement
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary me-md-2">
                            <i class="fas fa-times"></i>
                            Annuler
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-md-2">
                            <i class="fas fa-eye"></i>
                            Voir les détails
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            Sauvegarder les modifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script pour améliorer l'UX de sélection des entrainements
        document.addEventListener('DOMContentLoaded', function() {
            const checkboxes = document.querySelectorAll('input[name="SelectedTrainingIds"]');
            const updateCounter = () => {
                const selected = document.querySelectorAll('input[name="SelectedTrainingIds"]:checked').length;
                const label = document.querySelector('label[for="SelectedTrainingIds"]');
                if (label) {
                    const badge = label.querySelector('.badge') || document.createElement('span');
                    badge.className = 'badge bg-primary ms-2';
                    badge.textContent = `${selected} sélectionné(s)`;
                    if (!label.querySelector('.badge')) {
                        label.appendChild(badge);
                    }
                }
            };
            
            checkboxes.forEach(cb => {
                cb.addEventListener('change', function() {
                    updateCounter();
                    // Visual feedback for changes
                    const label = this.nextElementSibling;
                    const badge = label.querySelector('.badge.bg-success');
                    if (badge) {
                        if (this.checked) {
                            badge.textContent = 'Inclus';
                            badge.className = 'badge bg-success ms-2';
                        } else {
                            badge.textContent = 'Retiré';
                            badge.className = 'badge bg-warning ms-2';
                        }
                    }
                });
            });
            updateCounter(); // Initial count
        });
    </script>
}