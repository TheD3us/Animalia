@model Administration.Models.Entities.Event

@{
    ViewData["Title"] = "Détails de l'événement";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-header">
        <h4>@Model.Title</h4>
        <small class="text-muted">
            @if (Model.DateTime > DateTime.Now)
            {
                <span class="badge bg-success">À venir</span>
            }
            else
            {
                <span class="badge bg-secondary">Passé</span>
            }
        </small>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateTime)</dt>
            <dd class="col-sm-8">
                <strong>@Model.DateTime.ToString("dddd dd MMMM yyyy à HH:mm")</strong>
            </dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Location)</dt>
            <dd class="col-sm-8">
                <i class="fas fa-map-marker-alt"></i> @Model.Location
            </dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Notes)</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    @Model.Notes
                }
                else
                {
                    <span class="text-muted">Aucune note</span>
                }
            </dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaxParticipants)</dt>
            <dd class="col-sm-8">
                @if (Model.MaxParticipants.HasValue)
                {
                    <span class="badge bg-info">@Model.MaxParticipants participants max</span>
                }
                else
                {
                    <span class="text-muted">Nombre illimité</span>
                }
            </dd>

            <dt class="col-sm-4">Organisateur</dt>
            <dd class="col-sm-8">
                @if (Model.User != null)
                {
                    <span><i class="fas fa-user"></i> @Model.User.FullName</span>
                    @if (!string.IsNullOrEmpty(Model.User.Email))
                    {
                        <br><small class="text-muted"><i class="fas fa-envelope"></i> @Model.User.Email</small>
                    }
                }
                else
                {
                    <span class="text-muted">Utilisateur #@Model.UserId</span>
                }
            </dd>
        </dl>

     
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Supprimer</a>
            </div>
        </div>
    </div>
</div>