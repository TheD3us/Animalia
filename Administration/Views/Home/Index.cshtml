@inject Administration.Services.IAuthenticationService AuthService

@{
    ViewData["Title"] = "Tableau de bord - Administration";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-4">
                Tableau de bord
            </h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Gestion des Événements</h5>
                <p class="card-text">Créez, modifiez et gérez tous les événements d'Animalia.</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary">
                    Voir les événements
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Gestion des Programmes</h5>
                <p class="card-text">Administrez les programmes d'entraînement et leurs tarifs.</p>
                <a asp-controller="Programs" asp-action="Index" class="btn btn-success">
                    Voir les programmes
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Gestion des Entrainements</h5>
                <p class="card-text">Organisez les entrainements et leurs niveaux de difficulté.</p>
                <a asp-controller="Trainings" asp-action="Index" class="btn btn-warning">
                    Voir les entrainements
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    Actions rapides
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Events" asp-action="Create" class="btn btn-outline-primary w-100">
                            <i class="fas fa-plus"></i> Nouvel événement
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Programs" asp-action="Create" class="btn btn-outline-success w-100">
                            <i class="fas fa-plus"></i> Nouveau programme
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Trainings" asp-action="Create" class="btn btn-outline-warning w-100">
                            <i class="fas fa-plus"></i> Nouvel entrainement
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
